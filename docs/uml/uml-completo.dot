  TurnoDeLaIa -> RivalArtificial [dir=back arrowtail=odiamond];
  TurnoDeLaIa -> ObservadorDePartida [arrowhead=vee style=dashed xlabel=<escucha con una lambda>];
  RepresentacionPiezas -> RepresentacionConSprites [dir=back arrowtail=empty style=dashed];
  RepresentacionPiezas -> RepresentacionUnicode [dir=back arrowtail=empty style=dashed];
  RepresentacionConSprites -> RepresentacionPiezas [dir=back arrowtail=odiamond xlabel=<respaldo>];
  ObservadorDePartida -> SonidosDePartida [dir=back arrowtail=empty style=dashed];
  SonidosDePartida -> Partida [arrowhead=vee xlabel=<se suscribe>];
  SonidosDePartida -> GuionDeSonidos [dir=back arrowtail=diamond];
  SonidosDePartida -> CatalogoDeSonidos [dir=back arrowtail=odiamond];
  SonidosDePartida -> ReproductorDeAudio [dir=back arrowtail=odiamond];
  SonidosDePartida -> ControlDeVolumen [dir=back arrowtail=odiamond];
  SonidosDelMenu -> CatalogoDeSonidos [dir=back arrowtail=odiamond];
  SonidosDelMenu -> ReproductorDeAudio [dir=back arrowtail=odiamond];
  SonidosDelMenu -> ControlDeVolumen [dir=back arrowtail=odiamond];
  ReproductorDeAudio -> ReproductorJavaSound [dir=back arrowtail=empty style=dashed];
}
